# Copy to .env.local and fill in values. Never commit real secrets.

# --- Managed studio (demo mode, local MCP Apps testing) ---
DATABASE_URL=postgresql://vidio:vidio_local@127.0.0.1:54329/vidio
VIDIO_MODE=demo
VIDIO_MCP_LOCAL_AUTH=true
VIDIO_PUBLIC_ORIGIN=http://localhost:5000
# openssl rand -hex 32
VIDIO_PREVIEW_SECRET=

# Optional real AI footage in managed demo or production mode. Disabled by default.
# Anonymous shared ZeroGPU only. No HF token, paid GPU or credit fallback.
# Enabling this sends the selected image/prompt to the documented community Space.
VIDIO_WAN_ENABLED=false

# --- Managed studio (production mode; never set VIDIO_MCP_LOCAL_AUTH here) ---
# VIDIO_MODE=production
# NODE_ENV=production
# VIDIO_PUBLIC_ORIGIN=https://your-domain.example
# VIDIO_WIDGET_ORIGIN=
# OAUTH_ISSUER=
# OAUTH_JWKS_URL=
# OAUTH_AUDIENCE=
# VIDIO_MEDIA_SECRET=
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# VIDIO_PROVIDER_MEDIA_HOSTS=
# VIDIO_PAID_GENERATION_ENABLED=false
# VIDIO_MAX_PAID_SEGMENTS_PER_OWNER_DAY=
# VIDIO_WORKER_CONCURRENCY=2
# VIDIO_WORKER_LEASE_SECONDS=
# VIDIO_JOB_TIMEOUT_SECONDS=
# VIDIO_JOB_MAX_ATTEMPTS=

# --- Volcengine providers (legacy website and live video jobs) ---
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com
VIDEO_MODEL_EP=

# --- Legacy S3-compatible storage (legacy website only) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=cn-beijing
S3_ENDPOINT=https://tos-cn-beijing.volces.com
